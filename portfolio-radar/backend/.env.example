# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/portfolio_radar

# JWT Settings
SECRET_KEY=your-secret-key-change-this-in-production-use-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# OpenAI API
OPENAI_API_KEY=sk-your-openai-api-key-here

# News API (optional - will use mock data if not provided)
NEWS_API_KEY=your-newsapi-key-here

# GitHub Token (optional - helps avoid rate limiting)
GITHUB_TOKEN=ghp_your-github-token-here

# App Settings
DEBUG=True
